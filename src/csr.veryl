module csr (
    i_clk        : input  clock            ,
    i_rst        : input  reset            ,
    i_we         : input  logic            ,
    i_trap       : input  logic            ,
    i_op         : input  common::CsrOp    ,
    i_pc         : input  logic        <32>,
    i_mcause_next: input  logic        <32>,
    i_addr       : input  logic        <12>,
    i_wdata      : input  logic        <32>,
    o_rdata      : output logic        <32>,
    o_mtvec      : output logic        <32>,
    o_mepc       : output logic        <32>,
) {

    var mepc_we  : logic    ;
    var mepc_next: logic<32>; // Needed for MUXing control unit or wdata
    var mepc     : logic<32>;

    var mcause_we  : logic    ;
    var mcause_next: logic<32>; // Needed for MUXing control unit or wdata
    var mcause     : logic<32>;

    var mtvec_we: logic    ;
    var mtvec   : logic<32>;

    var csr_next: logic<32>;

    inst mepc_reg: register (
        i_clk             ,
        i_rst             ,
        i_we   : mepc_we  ,
        i_next : mepc_next,
        o_value: mepc     ,
    );

    assign o_mepc = mepc;

    inst mcause_reg: register (
        i_clk               ,
        i_rst               ,
        i_we   : mcause_we  ,
        i_next : mcause_next,
        o_value: mcause     ,
    );

    inst mtvec_reg: register (
        i_clk            ,
        i_rst            ,
        i_we   : mtvec_we,
        i_next : csr_next,
        o_value: mtvec   ,
    );

    assign o_mtvec = mtvec;

    always_comb {
        // Read
        case i_addr {
            12'h305: o_rdata = mtvec; // mtvec
            12'h341: o_rdata = mepc; // mepc
            12'h342: o_rdata = mcause; // mcause
            default: o_rdata = 0;
        }

        case i_op {
            common::CsrOp::WRITE: csr_next = i_wdata;
            common::CsrOp::SET  : csr_next = o_rdata | i_wdata;
            common::CsrOp::CLEAR: csr_next = o_rdata & ~i_wdata;
            default             : csr_next = i_wdata;
        }

        // Trap is prioritized over CSR write
        mepc_we   = i_trap || (i_we && i_addr == 12'h341);
        mcause_we = i_trap || (i_we && i_addr == 12'h342);

        // Trap MUXes register inputs
        mepc_next   = if i_trap ? i_pc : csr_next;
        mcause_next = if i_trap ? i_mcause_next : csr_next;

        mtvec_we = i_we && i_addr == 12'h305;

    }
}
