module register_file (
    i_clk: input  clock    ,
    i_rst: input  reset    ,
    i_we : input  logic    ,
    i_rs1: input  logic<5> ,
    i_rs2: input  logic<5> ,
    i_rd : input  logic<5> ,
    i_wd : input  logic<32>,
    o_rd1: output logic<32>,
    o_rd2: output logic<32>,
) {
    var regs: logic<32> [32];

    always_ff {
        if_reset {
            for i in 0..32 {
                regs[i] = 0;
            }
        } else if i_we && i_rd != 0 {
            regs[i_rd] = i_wd;
        }
    }

    always_comb {
        if i_rs1 == 0 {
            o_rd1 = 0;
        } else {
            o_rd1 = regs[i_rs1];
        }

        if i_rs2 == 0 {
            o_rd2 = 0;
        } else {
            o_rd2 = regs[i_rs2];
        }
    }
}
