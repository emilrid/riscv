module immediate (
    i_sel  : input  common::ImmType    ,
    i_instr: input  logic          <32>,
    o_imm  : output logic          <32>,
) {
    always_comb {
        case i_sel {
            common::ImmType::I_TYPE: o_imm = {
                i_instr[31] repeat 20, // Sign extend MSB
                i_instr[31:20],
            };

            common::ImmType::B_TYPE: o_imm = {
                i_instr[31] repeat 19, // Sign extend MSB
                i_instr[31], i_instr[7], i_instr[30:25], i_instr[11:8], 1'b0,
            };

            common::ImmType::S_TYPE: o_imm = {
                i_instr[31] repeat 20, // Sign extend MSB
                i_instr[31:25], i_instr[11:7],
            };

            common::ImmType::U_TYPE: o_imm = {i_instr[31:12], 12'b0,};

            common::ImmType::J_TYPE: o_imm = {
                i_instr[31] repeat 11, // Sign extend MSB
                i_instr[31], i_instr[19:12], i_instr[20], i_instr[30:21], 1'b0,
            };

            default                : o_imm = 0;
        }
    }
}
